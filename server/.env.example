NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Runtime role MUST be NOSUPERUSER NOBYPASSRLS. Never use DIRECT_URL for the server.
DATABASE_URL=postgresql://handoff_app:handoff_local_app@localhost:55440/handoff?schema=public
# Migration/seed administrator; used only by Prisma CLI and seed.
DIRECT_URL=postgresql://handoff_admin:handoff_local_admin@localhost:55440/handoff?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
# Optional service account JSON file. Omit for in-app notifications only.
FIREBASE_SERVICE_ACCOUNT_PATH=
